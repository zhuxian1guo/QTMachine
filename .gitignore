# --- 操作系统文件 ---
.DS_Store       # macOS 目录元数据
Thumbs.db       # Windows 缩略图缓存

# --- IDE 配置 ---
.idea/          # IntelliJ IDEA / PyCharm 等 JetBrains 系列
.vscode/        # VS Code 工作区配置
*.swp           # Vim 交换文件
*.swo           # Vim 交换文件
*~              # 备份文件
.qtcreator/     # Qt Creator 配置

# --- 依赖与构建产物 ---
node_modules/   # Node.js 依赖包
dist/           # 前端打包输出目录
target/         # Maven Java 构建输出
__pycache__/    # Python 字节码缓存
*.pyc           # Python 编译文件
build/          # Qt/C++ 构建目录 (通常包含 Makefile, object files 等)

# --- 敏感信息 ---
.env               # 环境变量文件 (包含密钥、数据库密码等)
*.key             # 私钥文件
*.pem           # 证书文件
