# --- 操作系统文件 ---
.DS_Store       # macOS
Thumbs.db       # Windows

# --- IDE 配置 ---
.idea/          # IntelliJ IDEA
.vscode/        # VS Code
*.swp           # Vim

# --- 依赖与构建产物 ---
node_modules/   # Node.js
dist/           # 前端打包输出
target/         # Maven Java
__pycache__/    # Python

# --- 敏感信息 ---
.env            # 环境变量文件
*.key           # 私钥
.qtcreator/  #QT
build/            #QT